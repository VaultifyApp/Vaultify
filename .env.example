# Template only. Copy to `.env` and fill in real values there.
# `.env` is gitignored; never put real secrets in this file.
# On Render, set these in the dashboard instead.

# Port the server listens on. Render injects this automatically.
PORT=3001

# MongoDB connection string. Include the database name before the "?".
DATABASE_URI=mongodb+srv://user:password@cluster.example.mongodb.net/vaultify?retryWrites=true&w=majority

# Spotify app credentials from https://developer.spotify.com/dashboard
CLIENT_ID=
CLIENT_SECRET=

# Must exactly match a redirect URI registered on the Spotify dashboard,
# and match the origin the client is served from.
# Local dev:   http://localhost:3000/login-callback
# Production:  https://<your-render-service>.onrender.com/login-callback
REDIRECT_URI=http://localhost:3000/login-callback

# OpenAI API key used to generate playlist covers.
# Optional: without it, cover generation fails but the server still runs.
OPENAI_API_KEY=

# MailerSend credentials for welcome/monthly emails
MAILER_KEY=
EMAIL=

# Set to "true" to run the monthly job in-process via node-schedule.
# Leave unset on hosts that idle the process, and use POST /run-monthly instead.
ENABLE_INTERNAL_CRON=true

# Shared secret required by POST /run-monthly. Unset disables that endpoint.
CRON_SECRET=
